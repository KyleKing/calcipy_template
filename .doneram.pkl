// Tool and GitHub Action versions shipped to generated projects. Each one is a
// literal in the file that consumes it. This file records where those literals
// are and how to resolve the latest value. python is absent on purpose, because
// it sets the language level a generated project targets and stays a copier
// answer.
//
// pypa/gh-action-pypi-publish is absent too: upstream recommends pinning to the
// `release/v1` branch rather than a tag, and a branch ref has no release to
// resolve against. Move that pin by hand when upstream advertises a new tip.
//
// A site that matches a different number of times than `expect` fails the run.
// A pattern that silently stops matching is how a pin goes stale unnoticed.
//
// The schema is inlined so this file evaluates today. It amends doneram's
// published Config.pkl once doneram ships a pkl package.

class Site {
  /// Repo-relative path to the file holding the literal.
  file: String
  /// Regex with exactly one capture group around the version.
  pattern: String
  expect: Int(this > 0) = 1
  window: Int(this > 0) = 1
}

/// Keeps taking updates below `max`, so a known break blocks only the majors
/// past it rather than freezing the pin.
class Hold {
  reason: String
  max: String?
}

class Tool {
  resolver: String = "mise"
  /// Name to query when it differs from the map key, e.g. "pipx:commitizen".
  resolverName: String?
  sites: Listing<Site>
  hold: Hold?
  /// Overrides the default `#.#.#` constraint, for a pin that only ever
  /// ships with a suffix (a prerelease tracked on purpose).
  pattern: String?
}

/// Brings the rendered .ctt output back in sync after any patch.
afterPatch: String = "uvx --from copier-template-tester ctt"

local miseToml = "mise.toml"
local ciYml = "package_template/.github/workflows/ci_pipeline.yml.jinja"
local publishYml = "package_template/.github/workflows/publish.yml.jinja"
local docsYml = "package_template/.github/workflows/update_docs.yml.jinja"
local setupAction = "package_template/.github/actions/setup/action.yml.jinja"
local rootBumpYml = ".github/workflows/bump_version.yml"
local rootFreshnessYml = ".github/workflows/freshness.yml"
local pkgFreshnessYml = "package_template/.github/workflows/freshness.yml"
local mkdocsYml = "package_template/mkdocs.yml.jinja"
local pkgMiseToml = "package_template/mise.toml.jinja"
local rootPreCommit = ".pre-commit-config.yaml"
local pkgPreCommit = "package_template/.pre-commit-config.yaml"

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String, count: Int): Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
  expect = count
}

/// A pre-commit hook's `rev:` line, one below its `repo:` URL, matched as a
/// two-line window anchored on the repo URL so the rev can't be confused
/// with another hook's.
local function hookPin(repoUrl: String, versionPattern: String, sourceFile: String): Site = new {
  file = sourceFile
  pattern = #"repo: https://github\.com/\#(repoUrl)\n\s*rev: "?\#(versionPattern)"?"#
  window = 2
}

tools: Mapping<String, Tool> = new {
  ["action-gh-release"] = new {
    resolver = "github-action"
    resolverName = "softprops/action-gh-release"
    sites = new {
      actionPin("softprops/action-gh-release", publishYml, 1)
      actionPin("softprops/action-gh-release", rootBumpYml, 1)
    }
  }
  ["actionlint"] = new {
    sites = new {
      new Site {
        file = miseToml
        pattern = #"^actionlint = "([\d.]+)""#
      }
    }
  }
  ["calcipy"] = new {
    resolverName = "pipx:calcipy"
    sites = new {
      new Site {
        file = miseToml
        pattern = #""pipx:calcipy" = \{extras = "recommended", version = "([\d.]+)"\}"#
      }
    }
  }
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", ciYml, 3)
      actionPin("actions/checkout", publishYml, 1)
      actionPin("actions/checkout", docsYml, 1)
      actionPin("actions/checkout", rootBumpYml, 1)
      actionPin("actions/checkout", rootFreshnessYml, 1)
      actionPin("actions/checkout", pkgFreshnessYml, 1)
    }
  }
  ["commitizen"] = new {
    resolver = "github-release"
    resolverName = "commitizen-tools/commitizen"
    sites = new {
      hookPin("commitizen-tools/commitizen", #"v([\d.]+)"#, rootPreCommit)
      hookPin("commitizen-tools/commitizen", #"v([\d.]+)"#, pkgPreCommit)
    }
  }
  ["copier-template-tester"] = new {
    resolver = "github-release"
    resolverName = "kyleking/copier-template-tester"
    sites = new { hookPin("kyleking/copier-template-tester", #"([\d.]+)"#, rootPreCommit) }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new {
      actionPin("peter-evans/create-pull-request", rootFreshnessYml, 1)
      actionPin("peter-evans/create-pull-request", pkgFreshnessYml, 1)
    }
  }
  ["doneram"] = new {
    resolver = "github-action"
    resolverName = "kyleking/doneram"
    sites = new {
      actionPin("kyleking/doneram", rootFreshnessYml, 1)
      actionPin("kyleking/doneram", pkgFreshnessYml, 1)
    }
  }
  ["doneram-version"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Site { file = rootFreshnessYml; pattern = #"version: v([\d.]+)"# }
      new Site { file = pkgFreshnessYml; pattern = #"version: v([\d.]+)"# }
    }
  }
  ["download-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/download-artifact"
    sites = new { actionPin("actions/download-artifact", publishYml, 3) }
  }
  ["mdformat"] = new {
    resolver = "github-release"
    resolverName = "executablebooks/mdformat"
    sites = new {
      hookPin("executablebooks/mdformat", #"([\d.]+)"#, rootPreCommit)
      hookPin("executablebooks/mdformat", #"([\d.]+)"#, pkgPreCommit)
    }
  }
  ["mirrors-prettier"] = new {
    resolver = "github-release"
    resolverName = "pre-commit/mirrors-prettier"
    pattern = "4.0.0-alpha.*"
    sites = new {
      hookPin("pre-commit/mirrors-prettier", #"v(4\.0\.0-alpha\.\d+)"#, rootPreCommit)
      hookPin("pre-commit/mirrors-prettier", #"v(4\.0\.0-alpha\.\d+)"#, pkgPreCommit)
    }
  }
  ["mise-action"] = new {
    resolver = "github-action"
    resolverName = "jdx/mise-action"
    sites = new {
      actionPin("jdx/mise-action", rootFreshnessYml, 1)
      actionPin("jdx/mise-action", pkgFreshnessYml, 1)
    }
  }
  ["pkl"] = new {
    sites = new {
      new Site {
        file = miseToml
        pattern = #"pkl = "([\d.]+)""#
      }
      new Site {
        file = pkgMiseToml
        pattern = #"pkl = "([\d.]+)""#
      }
    }
  }
  ["pre-commit-hooks"] = new {
    resolver = "github-release"
    resolverName = "pre-commit/pre-commit-hooks"
    sites = new {
      hookPin("pre-commit/pre-commit-hooks", #"v([\d.]+)"#, rootPreCommit)
      hookPin("pre-commit/pre-commit-hooks", #"v([\d.]+)"#, pkgPreCommit)
    }
  }
  ["pyright-action"] = new {
    resolver = "github-action"
    resolverName = "jakebailey/pyright-action"
    sites = new { actionPin("jakebailey/pyright-action", ciYml, 1) }
  }
  ["setup-python"] = new {
    resolver = "github-action"
    resolverName = "actions/setup-python"
    sites = new { actionPin("actions/setup-python", publishYml, 1) }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new {
      actionPin("astral-sh/setup-uv", publishYml, 2)
      actionPin("astral-sh/setup-uv", setupAction, 1)
      actionPin("astral-sh/setup-uv", rootFreshnessYml, 1)
    }
  }
  ["shellcheck-py"] = new {
    resolver = "github-release"
    resolverName = "shellcheck-py/shellcheck-py"
    sites = new {
      hookPin("shellcheck-py/shellcheck-py", #"v([\d.]+)"#, rootPreCommit)
      hookPin("shellcheck-py/shellcheck-py", #"v([\d.]+)"#, pkgPreCommit)
    }
  }
  ["tablesort"] = new {
    resolver = "cdnjs"
    resolverName = "tablesort@tristen/tablesort"
    sites = new {
      new Site {
        file = mkdocsYml
        pattern = #"cdnjs\.cloudflare\.com/ajax/libs/tablesort/([\d.]+)/tablesort\.min\.js"#
      }
    }
  }
  ["toml-sort"] = new {
    resolver = "github-release"
    resolverName = "pappasam/toml-sort"
    sites = new {
      hookPin("pappasam/toml-sort", #"v([\d.]+)"#, rootPreCommit)
      hookPin("pappasam/toml-sort", #"v([\d.]+)"#, pkgPreCommit)
    }
  }
  ["upload-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/upload-artifact"
    sites = new { actionPin("actions/upload-artifact", publishYml, 1) }
  }
}
