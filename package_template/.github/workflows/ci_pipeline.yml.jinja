---
name: CI Pipeline

"on":
  push:
    branches: [main]
  pull_request:
    paths:
      - .github/workflows/ci_pipeline.yml
      - {{ package_name_py }}/**
      - tests/**
      - uv.lock
      - pyproject.toml

jobs:{% raw %}
  lint:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: {% endraw %}["{{ minimum_python_short }}"]{% raw %}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
      - uses: ./.github/actions/setup
        with:
          python-version: ${{ matrix.python-version }}

      - name: Run static linters
        run: uv run calcipy-lint lint.check

  test:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [macos-latest, windows-latest]
        python-version: {% endraw %}["{{ minimum_python_short }}"]{% raw %}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
      - uses: ./.github/actions/setup
        with:
          python-version: ${{ matrix.python-version }}

      - name: Run test
        run: uv run calcipy-test test.pytest

  typecheck:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: {% endraw %}["{{ minimum_python_short }}"]{% raw %}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
      - uses: ./.github/actions/setup
        with:
          python-version: ${{ matrix.python-version }}

      - name: Run typecheck
        run: uv run calcipy-types types.mypy

      # pyright-action requires Python to be in PATH explicitly
      # Based on: https://github.com/jakebailey/pyright-action/issues/10#issuecomment-1455220629
      - name: Add uv Python to Path
        run: echo "$(uv run python -c 'import sys; print(sys.prefix)')/bin" >> $GITHUB_PATH
      - uses: jakebailey/pyright-action@6cabc0f01c4994be48fd45cd9dbacdd6e1ee6e5e # v2.3.3{% endraw %}
